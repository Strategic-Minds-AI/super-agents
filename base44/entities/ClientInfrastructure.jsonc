{
  "name": "ClientInfrastructure",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Name"
    },
    "client_id": {
      "type": "string",
      "title": "Client ID"
    },
    "stack_type": {
      "type": "string",
      "enum": [
        "static_site",
        "vite_app",
        "fullstack",
        "backend_api",
        "mobile_app"
      ],
      "default": "static_site",
      "title": "Stack Type",
      "description": "What kind of system is being provisioned"
    },
    "provision_status": {
      "type": "string",
      "enum": [
        "pending",
        "github_ready",
        "vercel_ready",
        "railway_ready",
        "supabase_ready",
        "domain_ready",
        "complete",
        "failed"
      ],
      "default": "pending",
      "title": "Provision Status"
    },
    "github_repo": {
      "type": "string",
      "title": "GitHub Repo"
    },
    "github_url": {
      "type": "string",
      "title": "GitHub URL"
    },
    "supabase_ref": {
      "type": "string",
      "title": "Supabase Ref"
    },
    "supabase_url": {
      "type": "string",
      "title": "Supabase URL"
    },
    "vercel_id": {
      "type": "string",
      "title": "Vercel ID"
    },
    "vercel_url": {
      "type": "string",
      "title": "Vercel URL"
    },
    "railway_id": {
      "type": "string",
      "title": "Railway ID"
    },
    "railway_service_id": {
      "type": "string",
      "title": "Railway Service ID"
    },
    "railway_url": {
      "type": "string",
      "title": "Railway URL"
    },
    "domain": {
      "type": "string",
      "title": "Domain",
      "description": "Custom domain configured for this system"
    },
    "domain_status": {
      "type": "string",
      "enum": [
        "pending",
        "available",
        "configured",
        "purchased",
        "failed"
      ],
      "default": "pending",
      "title": "Domain Status"
    },
    "deployment_url": {
      "type": "string",
      "title": "Deployment URL"
    },
    "env_vars": {
      "type": "string",
      "title": "Env Vars",
      "description": "JSON array of env var keys that have been set"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "code",
          "data"
        ]
      },
      "title": "Capabilities"
    }
  },
  "required": [
    "name",
    "client_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}