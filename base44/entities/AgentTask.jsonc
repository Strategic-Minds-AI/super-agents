{
  "name": "AgentTask",
  "type": "object",
  "properties": {
    "agent_name": {
      "type": "string",
      "title": "Agent",
      "description": "Which super-agent owns this task"
    },
    "domain": {
      "type": "string",
      "title": "Domain",
      "description": "Related domain (if any)"
    },
    "task_type": {
      "type": "string",
      "title": "Task Type",
      "description": "e.g. verify_ownership, submit_sitemap, competitor_scan, audit_seo"
    },
    "title": {
      "type": "string",
      "title": "Title"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "needs_approval",
        "completed",
        "failed"
      ],
      "default": "pending",
      "title": "Status"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "medium",
      "title": "Priority"
    },
    "result": {
      "type": "string",
      "title": "Result / Receipt"
    },
    "autonomous": {
      "type": "boolean",
      "title": "Autonomous",
      "description": "Can execute without approval",
      "default": false
    },
    "packet_id": {
      "type": "string"
    },
    "source_truth_version": {
      "type": "string"
    },
    "engines": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "action_class": {
      "type": "string",
      "enum": [
        "READ",
        "DRAFT",
        "BRANCH_WRITE",
        "PREVIEW_WRITE",
        "PROTECTED"
      ],
      "default": "DRAFT"
    },
    "idempotency_key": {
      "type": "string"
    },
    "timeout_ms": {
      "type": "number",
      "default": 120000
    },
    "retry_budget": {
      "type": "number",
      "default": 2
    },
    "lease_owner": {
      "type": "string"
    },
    "lease_expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "validation_contract": {
      "type": "string"
    },
    "rollback_pointer": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "terminal_state": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "UNKNOWN"
      ]
    }
  },
  "required": [
    "agent_name",
    "title",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}