# Repo-native Super Agents runtime
# Copy to .env for local Docker. Never commit .env.

POSTGRES_PASSWORD=replace-with-a-long-random-value
RUNTIME_TOKEN=replace-with-a-long-random-value

# Required only for tasks that invoke a model.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_BASE_URL=https://api.openai.com/v1

POLL_INTERVAL=60000
MAX_CYCLES=5
SOURCE_SHA=docker-local
